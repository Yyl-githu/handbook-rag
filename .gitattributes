# Auto detect text files and perform LF normalization
* text=auto eol=lf

# Shell scripts run inside the Linux database container; CRLF breaks bash.
*.sh   text eol=lf
# Windows entry points must stay CRLF.
*.cmd  text eol=crlf
*.ps1  text eol=crlf

# Binary assets
*.dump binary
*.png binary
*.ico binary
*.pdf binary