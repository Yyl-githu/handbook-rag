# 复制成 .env 后填写：cp .env.example .env
# .env 已被 .gitignore 忽略，不会提交。

# ===== 必填三项 =====
# 任意 OpenAI 兼容服务的 Key
LLM_API_KEY=
# 网页/接口登录密码
APP_PASSWORD=
# 数据库密码（compose 与本地运行都读它）
POSTGRES_PASSWORD=

# ===== 模型：默认阿里云百炼，换别家只改这一段 =====
SPRING_PROFILES_ACTIVE=aliyun
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_CHAT_MODEL=qwen3.7-plus
LLM_EMBEDDING_MODEL=text-embedding-v4
# 必须与数据库向量列一致；预置的 db/ragdemo.dump 是 1536 维
LLM_EMBEDDING_DIMENSIONS=1536
# 百炼有独立 rerank 接口；换成 OpenAI/DeepSeek 等请设为 false
RERANK_ENABLED=true

# ===== 可选 =====
APP_USERNAME=admin
LLM_TEMPERATURE=0.7

# 换成 OpenAI（示例，去掉行首 # 并填 Key）
#LLM_BASE_URL=https://api.openai.com/v1
#LLM_CHAT_MODEL=gpt-4o-mini
#LLM_EMBEDDING_MODEL=text-embedding-3-small
#LLM_EMBEDDING_DIMENSIONS=1536
#RERANK_ENABLED=false

# 换成 DeepSeek（注意：DeepSeek 没有 embedding 接口，需要另配嵌入服务）
#LLM_BASE_URL=https://api.deepseek.com/v1
#LLM_CHAT_MODEL=deepseek-chat
#RERANK_ENABLED=false